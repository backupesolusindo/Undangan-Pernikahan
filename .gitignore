# ====================================================================
# Git Ignore Configuration - Undangan Digital Pernikahan
# ====================================================================

# OS / Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Environment & Sensitive Files (Credentials)
.env
.env.*
!.env.example
!.env.production

# IDE / Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/sftp.json
.idea/
*.sublime-project
*.sublime-workspace

# Node / NPM Dependencies & Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json

# Build Outputs & Packaging
frontend/dist/
dist/
dist_cpanel/
build/
*.zip
*.tar.gz
*.rar

# CodeIgniter 4 Temporary & Writable Files
backend/writable/cache/*
!backend/writable/cache/index.html
backend/writable/logs/*
!backend/writable/logs/index.html
backend/writable/session/*
!backend/writable/session/index.html
backend/writable/debugbar/*
!backend/writable/debugbar/index.html
backend/writable/uploads/*
!backend/writable/uploads/index.html
php_errors.log
*.log

# Composer Vendor
vendor/
backend/vendor/

# User Uploaded Media (Exclude runtime uploads, keep placeholder)
backend/public/uploads/*
!backend/public/uploads/index.html
