# ====================================================================
# Konfigurasi Production CodeIgniter 4 untuk cPanel Hosting
# Ubah nama file ini menjadi `.env` di server cPanel Anda
# ====================================================================

CI_ENVIRONMENT = production

# URL Utama Website Anda di cPanel (Ganti sesuai nama domain Anda, sertakan https://)
app.baseURL = 'https://namadomainanda.com/'

# Hapus index.php dari URL agar URL bersih (/api/...)
app.indexPage = ''

# Konfigurasi Database cPanel MySQL
# Ganti dengan username, database, dan password yang dibuat di cPanel -> MySQL Databases
database.default.hostname = localhost
database.default.database = namausercpanel_undangan
database.default.username = namausercpanel_dbuser
database.default.password = PasswordKuatDatabase123!
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
